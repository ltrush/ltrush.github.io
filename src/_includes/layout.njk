<!DOCTYPE html>
<html lang="en">
   <head>
	<title>{{ title or "Luke Trusheim" }}</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="description" content="{{ description or 'Luke Trusheim — computer engineer focused on embedded systems, firmware, and hardware design.' }}">

	<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
	<link rel="stylesheet" href="/assets/css/styles.min.css" />
	<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  </head>

  <body>
	{% include "navbar.njk" %}

	<main>
	  {{ content | safe }}
	</main>

	{% include "footer.njk" %}

	<div class="lightbox" id="project-image-lightbox" hidden aria-hidden="true">
	  <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-label="Expanded project image">
		<button class="lightbox-close" id="project-image-lightbox-close" type="button" aria-label="Close expanded image">X</button>
		<img class="lightbox-image" id="project-image-lightbox-image" src="" alt="">
		<p class="lightbox-caption" id="project-image-lightbox-caption" hidden></p>
	  </div>
	</div>

	<script src="/assets/js/scripts.js"></script>
  </body>
</html>
