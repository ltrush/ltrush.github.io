<!DOCTYPE html>
<html lang="en">
   <head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	{% set pageTitle = (title + " — " + site.name) if title else site.defaultTitle %}
	{% set pageDescription = description or site.description %}
	{% set pageOgImage = ogImage or site.ogImage %}
	<title>{{ pageTitle }}</title>
	<meta name="description" content="{{ pageDescription }}">
	<link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">

	<meta property="og:type" content="{{ 'article' if project else 'website' }}">
	<meta property="og:site_name" content="{{ site.name }}">
	<meta property="og:title" content="{{ pageTitle }}">
	<meta property="og:description" content="{{ pageDescription }}">
	<meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
	<meta property="og:image" content="{{ pageOgImage | absoluteUrl(site.url) }}">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{{ pageTitle }}">
	<meta name="twitter:description" content="{{ pageDescription }}">
	<meta name="twitter:image" content="{{ pageOgImage | absoluteUrl(site.url) }}">

	<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
	<link rel="stylesheet" href="/assets/css/styles.min.css" />
	<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  </head>

  <body>
	{% include "navbar.njk" %}

	<main>
	  {{ content | safe }}
	</main>

	{% include "footer.njk" %}

	<div class="lightbox" id="project-image-lightbox" hidden aria-hidden="true">
	  <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-label="Expanded project image">
		<button class="lightbox-close" id="project-image-lightbox-close" type="button" aria-label="Close expanded image">X</button>
		<img class="lightbox-image" id="project-image-lightbox-image" src="" alt="">
		<p class="lightbox-caption" id="project-image-lightbox-caption" hidden></p>
	  </div>
	</div>

	<script src="/assets/js/scripts.js"></script>
  </body>
</html>
