{% macro projectCard(project, wide=false) %}
{% if wide %}
<div class="project project--wide">
  <div class="project-media">
    {% if project.projectPage and project.projectPage.enabled %}
    <a href="/projects/{{ project.slug }}/">
      <img class="project-image" src="{{ project.image }}" alt="{{ project.alt or project.title }}">
    </a>
    {% else %}
    <img class="project-image" src="{{ project.image }}" alt="{{ project.alt or project.title }}">
    {% endif %}
  </div>
  <div class="project-details">
    <div class="cta-row currently-building-pill">
      <span class="building-badge">Currently building</span>
    </div>
    <h3 class="project-name">{{ project.title }}</h3>
    {% set projectDateText = project | formatProjectDate %}
    {% if projectDateText %}
    <p class="project-date">{{ projectDateText }}</p>
    {% endif %}
    <p class="project-description">{{ project.description }}</p>
    <div class="project-tags">
      {% for tag in project.tags %}
      <span class="tag">{{ tag }}</span>
      {% endfor %}
    </div>
    {% if project.links %}
    <div class="cta-row currently-building-links">
      {% if project.projectPage and project.projectPage.enabled %}
      <a class="btn btn--primary" href="/projects/{{ project.slug }}/">Project Page</a>
      {% endif %}
      {% for l in project.links %}
      <a class="btn btn--ghost" href="{{ l.url }}" {% if l.newTab %}target="_blank" rel="noreferrer"{% endif %}>{{ l.label }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>
{% else %}
<div class="project">
  {% if project.projectPage and project.projectPage.enabled %}
  <a href="/projects/{{ project.slug }}/">
    <img class="project-image" src="{{ project.image }}" alt="{{ project.alt or project.title }}" loading="lazy" decoding="async">
  </a>
  {% else %}
  <img class="project-image" src="{{ project.image }}" alt="{{ project.alt or project.title }}" loading="lazy" decoding="async">
  {% endif %}
  <div class="project-details">
    <h3 class="project-name">{{ project.title }}</h3>
    {% set projectDateText = project | formatProjectDate %}
    {% if projectDateText %}
    <p class="project-date">{{ projectDateText }}</p>
    {% endif %}
    <p class="project-description">{{ project.description }}</p>
    <div class="project-tags">
      {% for tag in project.tags %}
      <span class="tag">{{ tag }}</span>
      {% endfor %}
    </div>
    <div class="cta-row">
      {% if project.projectPage and project.projectPage.enabled %}
      <a class="btn btn--primary" href="/projects/{{ project.slug }}/">Project Page</a>
      {% endif %}
      {% if project.links %}
        {% for l in project.links %}
        <a class="btn btn--ghost" href="{{ l.url }}" {% if l.newTab %}target="_blank" rel="noreferrer"{% endif %}>{{ l.label }}</a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>
{% endif %}
{% endmacro %}
