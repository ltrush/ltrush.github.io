---
layout: layout.njk
title: Portfolio
description: Projects and proof-of-concepts by Luke Trusheim — embedded systems, firmware, computer vision, and hardware design.
navSection: portfolio
---

{% from "macros/project-card.njk" import projectCard %}

<h1 class="page-title">Projects & Proof-of-Concepts</h1>
<p class="section-lead">Some of my passion projects, extracurricular activities, and classwork. Anything that I'm proud of goes here!</p>

{% set sortedProjects = projects | sortProjectsByDateDesc %}
{% set hasBuilding = false %}
{% for project in sortedProjects %}
    {% if project.currentlyBuilding %}
        {% set hasBuilding = true %}
    {% endif %}
{% endfor %}

{% if hasBuilding %}
<section class="currently-building">
    <div class="page-header">
        <div>
            <h2 class="page-title">Currently building</h2>
        </div>
    </div>

    <div class="portfolio portfolio--building">
        {% for project in sortedProjects %}
            {% if project.currentlyBuilding %}
                {{ projectCard(project, wide=true) }}
            {% endif %}
        {% endfor %}
    </div>
</section>
{% endif %}

<div class="page-header">
        <div>
            <h2 class="page-title">Completed</h2>
        </div>
</div>

<div class="portfolio">
    {% for project in sortedProjects %}
    {% if not project.currentlyBuilding %}
        {{ projectCard(project) }}
    {% endif %}
    {% endfor %}
</div>
